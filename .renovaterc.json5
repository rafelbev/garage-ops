{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#11.0.0"],
  schedule: ["at any time"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    {
      description: "searxng publishes calver date tags with a '-<commit-sha>' suffix (the sha changes per build). Under the default docker versioning the suffix is a semver prerelease, so every tag is filtered out and no updates are proposed. The shared preset's versioning rule only matches the GHCR name, and this image is pulled from Docker Hub, so define the tag shape here.",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^(docker\\.io\\/)?searxng\\/searxng$/"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$",
    },
    {
      description: "plantuml-server publishes tags with a 'jetty-v' prefix (e.g. jetty-v1.2021.7). The prefix is not a valid semver, so the default docker versioning cannot parse it. Define the tag shape here.",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^(docker\\.io\\/)?plantuml\\/plantuml-server$/"],
      versioning: "regex:^jetty-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["ghcr.io/siderolabs/installer", "siderolabs/talos", "talosctl"],
      minimumGroupSize: 3,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "linuxserver images: both carry ancient tags on Docker Hub that coerce into semver values above the real latest (lidarr 8.1.2135, qbittorrent 20.04.1), which Renovate would otherwise pick as 'latest'. Pin to the current major; bump when the app crosses a major.",
      matchDatasources: ["docker"],
      matchPackageNames: ["linuxserver/lidarr"],
      allowedVersions: "/^3\\./",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["linuxserver/qbittorrent"],
      allowedVersions: "/^5\\./",
    },
    {
      description: "Low-risk auto-merge: minor/patch/digest/pin updates that are not pre-1.0 and not flagged breaking in the changelog/release notes. Opens a PR that auto-merges once CI is green (automergeType overridden from the :automergeBranch preset's 'branch' to 'pr', so every auto-merged update is visible and gated by CI before it lands on main). Majors and 0.x are deliberately excluded (they can break at any time).",
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
      matchJsonata: ["isBreaking != true"],
      matchCurrentVersion: "!/^0/",
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "jackett is pre-1.0 (0.x) but mature and stable: give it the same low-risk auto-merge as non-0.x packages. The general rule's '!/^0/' exclusion would otherwise block it; this rule re-grants it for minor/patch/digest/pin that aren't flagged breaking. Majors and breaking changes to jackett stay manual.",
      matchPackageNames: ["linuxserver/jackett"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
      matchJsonata: ["isBreaking != true"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "open-terminal, readarr, n8n-sandbox-service, and echo are pre-1.0 (0.x) but mature and stable: same low-risk auto-merge as non-0.x packages (see the jackett rule above). Majors and breaking changes stay manual.",
      matchPackageNames: [
        "ghcr.io/open-webui/open-terminal",
        "ghcr.io/faustvii/readarr",
        "n8n-sandbox-service",
        "ghcr.io/home-operations/charts/echo",
      ],
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
      matchJsonata: ["isBreaking != true"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Never auto-merge updates Renovate flags as breaking from the changelog/release notes — these require a human to read the release notes before merging.",
      matchIsBreaking: true,
      automerge: false,
    },
  ],
}
